+impl<'a> RawJson<'a> {
+    pub(crate) fn member(self, encoded_key: &str) -> Option<Self> {
+        self.members()
+            .filter(|(key, _)| string::units(key).eq(string::units(encoded_key)))
+            .map(|(_, value)| value)
+            .last()
+    }
+}
